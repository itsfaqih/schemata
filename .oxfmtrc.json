{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "semi": true,
  "sortTailwindcss": { "stylesheet": "./src/index.css" },
  "ignorePatterns": [
    "pnpm-lock.yaml",
    ".agents/**",
    ".claude/**",
    "tools/oxlint/anti-slop/**",
    "tools/screenshots/annotate.js"
  ]
}
