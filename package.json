{
  "name": "schemata",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile && pnpm exec playwright install chromium",
    "dev": "portless run vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "pnpm run lint:ts && pnpm run lint:format && pnpm run lint:workflow",
    "lint:fix": "pnpm run lint:ts:fix && pnpm run lint:format:fix",
    "lint:ts": "tsrs -p tsconfig.json && oxlint --type-aware --deny-warnings",
    "lint:ts:fix": "oxlint --type-aware --fix",
    "lint:format": "oxfmt --check",
    "lint:format:fix": "oxfmt",
    "lint:workflow": "docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.12 -color",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.0.7",
