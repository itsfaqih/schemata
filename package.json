{
  "name": "schemata",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile && pnpm exec playwright install chromium",
    "dev": "portless run vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:flow": "playwright test -g",
    "lint": "pnpm run lint:ts && pnpm run lint:format && pnpm run lint:workflow",
    "lint:fix": "pnpm run lint:ts:fix && pnpm run lint:format:fix",
    "lint:ts": "tsrs -p tsconfig.json && oxlint --type-aware --deny-warnings",
    "lint:ts:fix": "oxlint --type-aware --fix",
    "lint:format": "oxfmt --check",
    "lint:format:fix": "oxfmt",
    "lint:workflow": "docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.12 -color",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/inter": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^6.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@xstate/react": "^6.1.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "localforage": "^1.10.0",
    "localforage-startswith": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-focus-lock": "^2.13.7",
    "react-hook-form": "^7.91.0",
    "react-hot-toast": "^2.6.1",
    "react-select": "^5.10.2",
    "tailwind-merge": "^1.8.0",
    "tailwindcss-radix": "^2.9.0",
    "universal-base64url": "^1.1.0",
    "use-undoable": "^5.0.0",
    "usehooks-ts": "^3.1.1",
    "xstate": "^5.33.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "autoprefixer": "^10.6.2",
    "eslint-plugin-playwright": "2.12.1",
    "fast-check": "4.10.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "portless": "0.15.12",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.3.7",
    "tailwindcss-animate": "^1.0.7",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "^6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
